<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.santehnik-cherkasy\.com$ [NC]
RewriteRule ^ https://santehnik-cherkasy.com%{REQUEST_URI} [R=301,L]
</IfModule>

# Vite assets and bundled fonts have content hashes in their filenames.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|mjs|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:svg|jpe?g|png|webp|avif|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
